APP_ENV=development
FRONTEND_URL=http://localhost:5173

MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=jarvis_session
SESSION_MAX_AGE=604800
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Used by the LangGraph assistant. Keep this backend-only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Keep SQLite locally. Use the Neon PostgreSQL URL in deployment.
DATABASE_URL=sqlite:///./jarvis.db
